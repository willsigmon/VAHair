# Acuity Scheduling API credentials
# Get these from: https://acuityscheduling.com/app.php?key=api&action=settings
ACUITY_USER_ID=your_user_id
ACUITY_API_KEY=your_api_key

# Optional: IndexNow submission (scripts/submit-indexnow.mjs)
INDEXNOW_KEY=
# Optional: override the canonical origin (defaults to https://vahair.studio)
SITE_URL=
